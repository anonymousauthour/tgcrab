# Telegram API credentials for tgcrab.
# Copy to .env and fill in values from https://my.telegram.org
# Alternatively, set these as environment variables, or place them in
# ~/.config/tgcrab/config.toml as:
#   api_id = 1234567
#   api_hash = "0123456789abcdef0123456789abcdef"
TG_API_ID=
TG_API_HASH=

# TDLib database encryption key fallback (used when the OS keyring is
# unavailable). Generate a random hex key, e.g. with `openssl rand -hex 32`.
# TGCRAB_DB_KEY=
